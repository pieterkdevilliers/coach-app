DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach
SCRIBE_API_URL=http://localhost:8012
SCRIBE_API_KEY=                        # Must match Scribe API's API_KEY value
SCRIBE_POLL_INTERVAL_SECONDS=60
FILE_STORAGE_PATH=/data/recordings
MAX_UPLOAD_SIZE_MB=1000
API_KEY=changeme                       # Coach App global API key

# JWT — change JWT_SECRET_KEY to a long random string in production
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
INVITE_TOKEN_EXPIRE_DAYS=7

# AWS S3 — for direct browser-to-S3 recording uploads
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_UPLOAD_EXPIRES=900    # seconds — pre-signed PUT URL lifetime
AWS_S3_READ_EXPIRES=14400    # seconds — pre-signed GET URL lifetime (for Scribe)
